#---------------------------------------------------------------------------------
# Makefile.arm7  —  ARM7 sub-project for Alone
#
# Compiles AudioArm7.cpp (and any other arm7/source/*.cpp files) with ARM7
# settings and links against lnds7.  The resulting ELF is written to
# arm7/arm7.elf so the top-level Makefile can pass it to ndstool via -7.
#
# Key differences from the ARM9 build
# ------------------------------------
#   • Architecture: armv4t / arm7tdmi  (the ARM7TDMI core in the NDS)
#   • Thumb interworking: -mthumb-interwork (ARM7 calls BIOS in ARM state)
#   • Library:       lnds7  (NOT lnds9 — completely separate ABI)
#   • No -lfat:      the ARM7 never touches the SD card
#   • -DARM7:        guards AudioArm7.cpp code with #ifdef ARM7
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif

include $(DEVKITARM)/ds_rules

#---------------------------------------------------------------------------------
TARGET		:= arm7
BUILD		:= build_arm7
SOURCES		:= arm7/source
INCLUDES	:= common/include $(BUILD)

#---------------------------------------------------------------------------------
# ARM7TDMI is ARMv4T.  -mthumb-interwork is mandatory because BIOS calls
# (swiIntrWait etc.) are ARM-state routines and the linker must generate
# BX-safe veneers for any Thumb→ARM transitions.
# Do NOT use -mthumb alone here; it breaks the BIOS call convention.
#---------------------------------------------------------------------------------
ARCH		:= -march=armv4t -mtune=arm7tdmi -mthumb -mthumb-interwork

CFLAGS		:= -g -Wall -O2 \
		   $(ARCH)
CFLAGS		+= $(INCLUDE) -DARM7

CXXFLAGS	:= $(CFLAGS) -fno-rtti -fno-exceptions

ASFLAGS		:= -g $(ARCH)
LDFLAGS		:= -specs=ds_arm7.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)

# ARM7 links only against lnds7.  No FAT, no C++ runtime beyond what
# -fno-rtti/-fno-exceptions leaves in libgcc.
LIBS		:= -lnds7

LIBDIRS		:= $(LIBNDS)

#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT	:= $(CURDIR)/arm7/$(TARGET)

export VPATH	:= $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR	:= $(CURDIR)/$(BUILD)

CFILES		:= $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:= $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES		:= $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
BINFILES	:= $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.bin)))

ifeq ($(strip $(CPPFILES)),)
	export LD	:= $(CC)
else
	export LD	:= $(CXX)
endif

export OFILES	:= $(BINFILES:.bin=.o) \
		   $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)

export INCLUDE	:= $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
		   $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
		   -I$(CURDIR)/$(BUILD)

export LIBPATHS	:= $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: $(BUILD) clean

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@[ -d arm7 ] || mkdir -p arm7
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.arm7

clean:
	@echo clean arm7 ...
	@rm -fr $(BUILD) arm7/$(TARGET).elf

#---------------------------------------------------------------------------------
else
#---------------------------------------------------------------------------------

DEPENDS		:= $(OFILES:.o=.d)

$(OUTPUT).elf	: $(OFILES)

%.o	: %.bin
	@echo $(notdir $<)
	$(bin2o)

-include $(DEPENDS)

endif
