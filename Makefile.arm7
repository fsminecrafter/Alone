#---------------------------------------------------------------------------------
# Makefile.arm7  —  ARM7 sub-project for Alone (calico build)
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif

include $(DEVKITARM)/ds_rules

#---------------------------------------------------------------------------------
TARGET      := arm7
BUILD       := build_arm7
SOURCES     := arm7/source
INCLUDES    := common/include $(BUILD)

CALICO      := /opt/devkitpro/calico
LIBNDS_DIR  := /opt/devkitpro/libnds

#---------------------------------------------------------------------------------
ARCH        := -march=armv4t -mtune=arm7tdmi -mthumb -mthumb-interwork

CFLAGS      := -g -Wall -O2 \
               $(ARCH)
CFLAGS      += $(INCLUDE) -DARM7

CXXFLAGS    := $(CFLAGS) -fno-rtti -fno-exceptions

ASFLAGS     := -g $(ARCH)
LDFLAGS     := -specs=ds_arm7.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)

LIBS        := -lcalico_ds7 -lnds7

LIBDIRS     := $(CALICO) $(LIBNDS_DIR)

#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT   := $(CURDIR)/arm7/$(TARGET)

export VPATH    := $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR  := $(CURDIR)/$(BUILD)

CFILES      := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES    := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES      := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
BINFILES    := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.bin)))

ifeq ($(strip $(CPPFILES)),)
    export LD   := $(CC)
else
    export LD   := $(CXX)
endif

export OFILES   := $(BINFILES:.bin=.o) \
                   $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)

export INCLUDE  := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
                   $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                   -I$(CURDIR)/$(BUILD)

export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: $(BUILD) clean

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@[ -d arm7 ] || mkdir -p arm7
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.arm7

clean:
	@echo clean arm7 ...
	@rm -fr $(BUILD) arm7/$(TARGET).elf

#---------------------------------------------------------------------------------
else
#---------------------------------------------------------------------------------

DEPENDS     := $(OFILES:.o=.d)

$(OUTPUT).elf   : $(OFILES)

%.o : %.bin
	@echo $(notdir $<)
	$(bin2o)

-include $(DEPENDS)

endif